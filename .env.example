# ──────────────────────────────────────────────
# SouthernVT Environment Variables
# Copy to .env.local for local development.
# Set all required vars in Vercel before deploying to production.
# See docs/production-env-checklist.md for full setup guide.
# ──────────────────────────────────────────────

# Core
NEXT_PUBLIC_APP_URL=https://www.southernvt.com
NEXT_PUBLIC_SITE_URL=https://southernvt.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_REPOSITORY_MODE=supabase

# Auth / Basecamp
BASECAMP_ADMIN_EMAILS=

# Email — Resend
RESEND_API_KEY=
CONTACT_EMAIL_FROM="SouthernVT <hello@southernvt.com>"
CLAIMS_EMAIL_FROM="SouthernVT <partners@southernvt.com>"
PARTNERS_EMAIL_TO=partners@southernvt.com
GENERAL_EMAIL_TO=hello@southernvt.com
PRESS_EMAIL_TO=press@southernvt.com
# Backward compatibility (optional if PARTNERS_EMAIL_TO is set)
CLAIMS_ADMIN_EMAIL=partners@southernvt.com

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# AI
OPENAI_API_KEY=

# Stripe (optional — for paid listing upgrades)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mapbox (optional)
NEXT_PUBLIC_MAPBOX_TOKEN=
